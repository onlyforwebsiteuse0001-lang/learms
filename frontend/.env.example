# All values are OPTIONAL. The app works with none of them set.

# Dev-server proxy target. Default is the docker-compose service name used by nginx.conf.
# Use http://localhost:8000 when running FastAPI directly on the host.
VITE_DEV_API_TARGET=http://backend:8000

# Absolute API base. LEAVE UNSET in normal deployments — the app is same-origin and calls
# relative /api paths. Only set this when serving the frontend from a different origin.
# VITE_API_BASE_URL=

# Try the WebSocket transport for job progress before falling back to polling.
# Agent 1 has NOT shipped /api/v1/ws/jobs/{job_id} yet, so this defaults to false.
VITE_ENABLE_WS=false

# Shows a persistent "demo data" banner. Set this ONLY together with the mock API server
# (npm run mock:api) so nobody mistakes mock numbers for real student data.
VITE_DEMO_MODE=false
