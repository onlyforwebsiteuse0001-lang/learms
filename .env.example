# Application
APP_ENV=development
APP_NAME=HAAFIZ EDU
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
SECRET_KEY=replace-with-at-least-32-random-characters
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
LOG_LEVEL=INFO

# PostgreSQL
POSTGRES_DB=haafiz
POSTGRES_USER=haafiz
POSTGRES_PASSWORD=change-this-database-password
DATABASE_URL=postgresql+asyncpg://haafiz:change-this-database-password@postgres:5432/haafiz

# Redis / task queue
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Object storage (optional; local storage is used in development)
STORAGE_BACKEND=local
UPLOAD_DIR=/app/data/uploads
MAX_UPLOAD_MB=50
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=

# AI providers — leave blank to disable the provider. Never commit real keys.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen-2.5-72b-instruct:free
AI_REQUEST_TIMEOUT_SECONDS=45

# OCR
TESSERACT_CMD=/usr/bin/tesseract
TESSERACT_LANGUAGES=eng+urd
OCR_DPI=300

# Bootstrap administrator (development only; change before deployment)
HAAFIZ_ADMIN_EMAIL=admin@haafiz.edu.pk
HAAFIZ_ADMIN_PASSWORD=replace-with-a-strong-admin-password
